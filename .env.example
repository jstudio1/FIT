DATABASE_URL=mysql://user:password@127.0.0.1:3306/trainner
AUTH_SECRET=replace-with-a-cryptographically-random-value-at-least-32-characters
# Set temporarily to the prior secret during key rotation.
AUTH_SECRET_PREVIOUS=
AUDIT_PEPPER=replace-with-a-separate-random-value-at-least-32-characters
OWNER_USERNAME=owner
OWNER_PASSWORD=replace-with-a-strong-password-at-least-12-characters
OWNER_NAME=System Owner
# ตรวจอาหารอัตโนมัติด้วย AI (ใช้เมื่อเทรนเนอร์เปิดโหมด auto)
# Google Vision ต้องใช้ service account (IAM & Admin > Service Accounts > Keys > Create JSON key)
# ไม่ใช่ API key ธรรมดา — คัดลอกค่า client_email/private_key จากไฟล์ JSON มาใส่ตรงนี้
GOOGLE_SA_CLIENT_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
USDA_FDC_API_KEY=
